<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MoonSweeperEditor"
        x:Class="MoonSweeperEditor.MainWindow"
        Title="Moon Sweepers – Savegame Editor"
        Icon="/Assets/icon.png"
        Width="1320" Height="860" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="13">

    <Window.Resources>
        <l:ChoiceConverter x:Key="ChoiceConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="300,*">

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="/Assets/icon.png" Width="52" Height="52" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Moon Sweepers" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{l:T Subtitle}" Foreground="{StaticResource Muted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="FlagEn" Classes="flag" Click="LanguageEnglish_Click">
                                <Image Source="{StaticResource FlagUS}" Width="26" Height="14" Stretch="Fill" />
                            </Button>
                            <Button x:Name="FlagDe" Classes="flag" Click="LanguageGerman_Click">
                                <Image Source="{StaticResource FlagDE}" Width="26" Height="14" Stretch="Fill" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="8">
                    <Button Content="{l:T Reload}" Click="Reload_Click" HorizontalAlignment="Stretch" />
                    <Button Content="{l:T OpenSaveFolder}" Click="OpenSaveFolder_Click" HorizontalAlignment="Stretch" />
                    <Button Content="{l:T ChooseSaveFolder}" Click="ChooseSaveFolder_Click" HorizontalAlignment="Stretch" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="{l:T SaveGames}" Foreground="{StaticResource Muted}" FontSize="11"
                           FontWeight="SemiBold" Margin="2,0,0,8" />

                <ListBox x:Name="SlotList" SelectionChanged="SlotList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastPlayedText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                </DockPanel>
                                <TextBlock Text="{Binding BalanceText}" Foreground="{StaticResource Gold}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding PlayTimeText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="·" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,0" />
                                    <TextBlock Text="{Binding RegionsText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{l:T Regions}" Foreground="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Main ============ -->
        <DockPanel Grid.Column="1" Margin="22,18,22,16">

            <!-- Game running banner -->
            <Border x:Name="GameRunningBanner" DockPanel.Dock="Top" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}"
                    BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,12" IsVisible="False">
                <TextBlock Foreground="{StaticResource Warn}" TextWrapping="Wrap" Text="{l:T GameRunning}" />
            </Border>

            <!-- Header -->
            <Border DockPanel.Dock="Top" Classes="card" Padding="18,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="18,0">
                            <TextBlock Text="{l:T PlayTime}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeaderPlayTime" Text="–" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="18,0">
                            <TextBlock Text="{l:T RegionsHeader}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeaderRegions" Text="–" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="18,0,0,0">
                            <TextBlock Text="{l:T LastPlayed}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeaderLastPlayed" Text="–" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" Classes="h1" />
                        <TextBlock x:Name="HeaderPath" Classes="hint" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bottom bar -->
            <Border DockPanel.Dock="Bottom" Classes="card" Padding="14,10" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DiscardButton" Content="{l:T Discard}" Click="Discard_Click" Margin="0,0,10,0" IsEnabled="False" />
                        <Button x:Name="SaveButton" Content="{l:T SaveChanges}" Classes="accent" Padding="18,8" Click="Save_Click" IsEnabled="False" />
                    </StackPanel>
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"
                               Text="{l:T Ready}" />
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <TabControl x:Name="Tabs" Margin="0,8,0,0" IsEnabled="False">

                <!-- ===== Money ===== -->
                <TabItem Header="{l:T TabMoney}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="{l:T TeamBalance}" Classes="h2" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="$" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Gold}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox x:Name="BalanceBox" DockPanel.Dock="Left" FontSize="24" FontWeight="SemiBold" Width="360"
                                                 TextChanged="BalanceBox_TextChanged" />
                                        <TextBlock x:Name="BalanceError" Foreground="{StaticResource Bad}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </DockPanel>
                                    <WrapPanel x:Name="QuickAmounts" Margin="0,12,0,0">
                                        <Button Classes="small" Tag="10000" Click="AddMoney_Click" Margin="0,0,8,8" />
                                        <Button Classes="small" Tag="100000" Click="AddMoney_Click" Margin="0,0,8,8" />
                                        <Button Classes="small" Tag="1000000" Click="AddMoney_Click" Margin="0,0,8,8" />
                                        <Button Classes="small" Tag="10000000" Click="AddMoney_Click" Margin="0,0,8,8" />
                                        <Button Classes="small" Tag="=999999999" Click="AddMoney_Click" Margin="0,0,8,8" />
                                        <Button Classes="small" Tag="=0" Click="AddMoney_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:T BalanceHint}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T Accounts}" Classes="h2" />
                                    <TextBlock Classes="hint" Margin="0,0,0,10" Text="{l:T AccountsHint}" />
                                    <ItemsControl x:Name="WalletItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="200,230,230,*" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <TextBlock DockPanel.Dock="Left" Text="$" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Text="{Binding Dollars, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsOther}"
                                                                 ToolTip.Tip="{l:T TeamEditedAbove}" />
                                                    </DockPanel>
                                                    <DockPanel Grid.Column="2">
                                                        <TextBlock DockPanel.Dock="Right" Text="kg" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        <TextBox Text="{Binding PendingKilograms, StringFormat={}{0:N3}, UpdateSourceTrigger=LostFocus}" />
                                                    </DockPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T Stats}" Classes="h2" />
                                    <TextBlock x:Name="StatsMissing" Classes="hint" IsVisible="False" Text="{l:T StatsMissing}" />
                                    <ItemsControl x:Name="StatItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="240,230,*" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <DockPanel Grid.Column="1">
                                                        <TextBlock DockPanel.Dock="Left" Text="$" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Text="{Binding Value, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" />
                                                    </DockPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="hint" Margin="0,4,0,0" Text="{l:T StatsHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Tools ===== -->
                <TabItem Header="{l:T TabTools}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Classes="card">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Classes="small" Content="{l:T UnlockAll}" Click="UnlockAllTools_Click" Margin="0,0,8,0" />
                                            <Button Classes="small" Content="{l:T MaxAll}" Click="MaxAllTools_Click" />
                                        </StackPanel>
                                        <TextBlock Text="{l:T Tools}" Classes="h2" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Grid ColumnDefinitions="230,170,140,*" Margin="0,0,0,6">
                                        <TextBlock Classes="col" Text="{l:T ColTool}" />
                                        <TextBlock Classes="col" Grid.Column="1" Text="{l:T ColOwned}" />
                                        <TextBlock Classes="col" Grid.Column="2" Text="{l:T ColLevel}" />
                                        <TextBlock Classes="col" Grid.Column="3" Text="{l:T ColNote}" />
                                    </Grid>
                                    <ItemsControl x:Name="ToolItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid ColumnDefinitions="230,170,140,*">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Id}" Classes="hint" FontSize="11" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding Owned}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding Level}"
                                                                  IsVisible="{Binding Upgradable}" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding OwnedHint}" Classes="hint" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="hint" Margin="0,8,0,0" Text="{l:T ToolsHint}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T Loadout}" Classes="h2" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="{l:T EquippedTool}" VerticalAlignment="Center" Width="200" />
                                        <ComboBox x:Name="EquippedBox" Width="230" SelectionChanged="AnyCombo_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="{l:T ActiveSlot}" VerticalAlignment="Center" Width="200" />
                                        <ComboBox x:Name="SelectedSlotBox" Width="230" SelectionChanged="AnyCombo_SelectionChanged" />
                                    </StackPanel>
                                    <ItemsControl x:Name="HotbarItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="10" Margin="0,0,10,10" Width="200">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
                                                        <ComboBox ItemsSource="{Binding $parent[Window].ToolChoices}"
                                                                  SelectedItem="{Binding Tool, Converter={StaticResource ChoiceConverter}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="hint" Text="{l:T HotbarHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Upgrade tree ===== -->
                <TabItem Header="{l:T TabTree}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Classes="small" Content="{l:T AllMinus}" Tag="-1" Click="TreeAll_Click" Margin="0,0,8,0" />
                                    <Button Classes="small" Content="{l:T AllPlus}" Tag="+1" Click="TreeAll_Click" Margin="0,0,16,0" />
                                    <TextBlock Text="{l:T AllToLevel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="TreeAllLevel" Width="80" Margin="0,0,8,0" />
                                    <Button Classes="small" Content="{l:T Apply}" Click="TreeSetAll_Click" />
                                </StackPanel>
                                <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T TreeHint}" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NodeItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="14,12" Margin="0,0,12,12" Width="300">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Classes="step" Content="−" Tag="-1" Click="NodeStep_Click" />
                                                    <TextBlock Text="{Binding Level}" Width="34" TextAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                                                    <Button Classes="step" Content="+" Tag="+1" Click="NodeStep_Click" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Id}" Classes="hint" FontSize="11" />
                                                        <TextBlock Text="·" Classes="hint" FontSize="11" />
                                                        <TextBlock Text="{Binding LevelText}" Classes="hint" FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ===== Storage ===== -->
                <TabItem Header="{l:T TabStorage}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{l:T Filter}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CanisterFilter" Width="170" Margin="0,0,16,0" SelectionChanged="CanisterFilter_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Classes="small" Content="{l:T FillFiltered}" Tag="fill" Click="CanisterBulk_Click" Margin="0,0,8,0" />
                                    <Button Classes="small" Content="{l:T EmptyFiltered}" Tag="empty" Click="CanisterBulk_Click" />
                                </StackPanel>
                                <TextBlock x:Name="CanisterSummary" Classes="hint" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Classes="card" Padding="14,10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="150,*,170,140,100" Margin="0,0,14,8">
                                    <TextBlock Classes="col" Text="{l:T ColType}" />
                                    <TextBlock Classes="col" Grid.Column="1" Text="{l:T ColKey}" />
                                    <TextBlock Classes="col" Grid.Column="2" Text="{l:T ColAmount}" />
                                    <TextBlock Classes="col" Grid.Column="3" Text="{l:T ColCapacity}" TextAlignment="Right" />
                                    <TextBlock Classes="col" Grid.Column="4" Text="{l:T ColFill}" TextAlignment="Right" />
                                </Grid>
                                <!-- ListBox for virtualization: big bases have over a thousand entries -->
                                <ListBox x:Name="CanisterItems" Classes="plain">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,5">
                                                    <Grid ColumnDefinitions="150,*,170,140,100" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Kind}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Key}" Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBox Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}" Width="150" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Capacity, StringFormat={}{0:N0}}" VerticalAlignment="Center" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Fill}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Gold}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- ===== Backups ===== -->
                <TabItem Header="{l:T TabBackups}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Classes="small" Content="{l:T BackupNow}" Click="BackupNow_Click" Margin="0,0,8,0" />
                                    <Button Classes="small" Content="{l:T RestoreSelected}" Click="RestoreBackup_Click" Margin="0,0,8,0" />
                                    <Button Classes="small" Content="{l:T OpenBackupFolder}" Click="OpenBackupFolder_Click" />
                                </StackPanel>
                                <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T BackupHint}" />
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="BackupList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding When}" FontWeight="SemiBold" Width="200" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ===== Advanced ===== -->
                <TabItem Header="{l:T TabAdvanced}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="{l:T RawData}" Classes="h2" />
                                    <TextBlock Classes="hint" Margin="0,0,0,12" Text="{l:T RawHint}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:T ExportRaw}" Click="ExportRaw_Click" Margin="0,0,10,0" />
                                        <Button Content="{l:T ImportRaw}" Click="ImportRaw_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T TechDetails}" Classes="h2" />
                                    <TextBox x:Name="InfoBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, monospace"
                                             FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" MinHeight="220" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
