<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the Linux (Avalonia) editor headless on a copy of a save folder. Usage: see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoonSweeperEditor.Linux\MoonSweeperEditor.Linux.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

</Project>
